<?xml version="1.0" encoding="utf-8"?>
<!--
  The themed-icon layer, for Android 13 and later.

  Themed icons are tinted by the system with a single colour and everything else is discarded, so
  anything here has to be one flat shape. The front wave alone, at full weight - the swell behind
  it would be tinted the same as the front and the pair would read as one thick smear.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M22,63 Q37,51 52,63 Q67,75 82,63"
        android:strokeColor="#000000"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
</vector>