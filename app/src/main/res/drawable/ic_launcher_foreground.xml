<?xml version="1.0" encoding="utf-8"?>
<!--
  A wave drawn in dots.

  Two lines of dots rather than two strokes, because a dotted line reads as water and a
  solid one reads as a graph. The dots sit on two quadratic curves - the same pair of
  arches the stroke version used, so the shape of the swell is unchanged - and each one
  tapers along the way, which is the only thing that makes a row of dots look like it is
  moving rather than like a dotted rule.

  The eleven front dots and six behind are placed by hand along those curves rather than
  being generated at runtime, because a launcher icon is a drawable and anything computed
  would have to be drawn into a canvas instead.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The swell behind: a second dotted line, higher up and lighter. -->
    <path android:pathData="M28,45 a2.2,2.2 0 1,0 4.4,0 a2.2,2.2 0 1,0 -4.4,0" android:fillColor="#8FD6F2" />
    <path android:pathData="M36,41.6 a2.1,2.1 0 1,0 4.2,0 a2.1,2.1 0 1,0 -4.2,0" android:fillColor="#8FD6F2" />
    <path android:pathData="M44,39.6 a2.0,2.0 0 1,0 4.0,0 a2.0,2.0 0 1,0 -4.0,0" android:fillColor="#8FD6F2" />
    <path android:pathData="M52,39.6 a1.9,1.9 0 1,0 3.8,0 a1.9,1.9 0 1,0 -3.8,0" android:fillColor="#8FD6F2" />
    <path android:pathData="M60,41.6 a1.8,1.8 0 1,0 3.6,0 a1.8,1.8 0 1,0 -3.6,0" android:fillColor="#8FD6F2" />
    <path android:pathData="M68,45 a1.7,1.7 0 1,0 3.4,0 a1.7,1.7 0 1,0 -3.4,0" android:fillColor="#8FD6F2" />

    <!-- The wave in front: bigger, white, tapering as it goes. -->
