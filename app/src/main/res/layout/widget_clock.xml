<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher's own clock. Two tap targets on purpose: the time opens the clock app and the
  date opens the calendar, which is what each of them is for.

  Both fill the width, so a tap anywhere along a row lands on something rather than only on the
  characters themselves. The battery is a plain TextView and not a third clock: it is the one
  line here that does not come from the time, so it is written out on each draw. Their height is whatever the chosen size needs: sharing the slot's
  height between them by weight instead meant a size larger than its share was cut off, and the
  size is the one thing here that is asked for outright.

  TextClock rather than a label this app keeps updating: it ticks on its own inside the host,
  follows the system's 12- and 24-hour setting, and localizes both formats without being told.
  No autosizing: it makes a TextView ignore the size it is given, which is how the size
  setting came to do nothing at all.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <TextClock
        android:id="@+id/widget_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:textColor="@color/widget_clock_text"
        android:textSize="44sp"
        android:maxLines="1"
        android:gravity="start"
        android:shadowColor="#80000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:contentDescription="@string/widget_clock_time" />

    <TextClock
        android:id="@+id/widget_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:format12Hour="EEEE, d MMMM"
        android:format24Hour="EEEE, d MMMM"
        android:textColor="@color/widget_clock_text"
        android:textSize="16sp"
        android:maxLines="1"
        android:gravity="start"
        android:shadowColor="#80000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:contentDescription="@string/widget_clock_date" />

    <!--
        Icon and temperature together. The glyph is what says "rain" at a glance across the
        room; the degrees are the part anyone actually reads. The words the weather app sent
        are kept for the content description rather than drawn, because a row reading "21°C
        Partly cloudy" under a part-cloudy glyph says the same thing twice.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_weather_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="6dp"
            android:visibility="gone"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/widget_weather"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/widget_clock_text"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone"
            android:gravity="start"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_notifications"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_clock_text"
        android:textSize="14sp"
        android:maxLines="1"
        android:visibility="gone"
        android:gravity="start"
        android:shadowColor="#80000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:contentDescription="@string/widget_clock_notifications" />

    <TextView
        android:id="@+id/widget_event_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_clock_text"
        android:textSize="14sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone"
        android:gravity="start"
        android:shadowColor="#80000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:contentDescription="@string/widget_clock_agenda" />

    <TextView
        android:id="@+id/widget_event_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_clock_text"
        android:textSize="14sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone"
        android:gravity="start"
        android:shadowColor="#80000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:contentDescription="@string/widget_clock_agenda" />

    <TextView
        android:id="@+id/widget_event_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_clock_text"
        android:textSize="14sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone"
        android:gravity="start"
        android:shadowColor="#80000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:contentDescription="@string/widget_clock_agenda" />

    <TextView
        android:id="@+id/widget_alarm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_clock_text"
        android:textSize="14sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone"
        android:gravity="start"
        android:shadowColor="#80000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:contentDescription="@string/widget_clock_agenda" />

    <TextView
        android:id="@+id/widget_battery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_clock_text"
        android:textSize="14sp"
        android:maxLines="1"
        android:visibility="gone"
        android:gravity="start"
        android:shadowColor="#80000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:contentDescription="@string/widget_clock_battery" />
</LinearLayout>
